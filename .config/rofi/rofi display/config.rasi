configuration {
    modi: "drun,filebrowser,window,run,emoji";
    show-icons: true;
    display-drun: "";
    display-run: "";
    display-filebrowser: "";
    display-window: "";
    drun-display-format: "{name}";
    window-format: "{w}{t}";
    font: "pixelon 12";
    icon-theme: "default";
    prompt: "";
    show-prompt: true;
    prompt-ellipsis: false;
}

@theme "/home/tumbleweed/dotfiles/.config/rofi/hyprland/theme.rasi"

window {
    height: 650px;
    width: 600px;
    transparency: "real";
    fullscreen: false;
    enabled: true;
    cursor: "default";
    spacing: 0px;
    padding: 0px;
    border: 3px;
    border-radius: 40px;
    border-color: @main-br;
    background-color: transparent;
    anchor: center;
    location: 0;
    anchor: 0;
}

mainbox {
    enabled: true;
    spacing: 0px;
    padding: 0px;
    orientation: vertical;
    children: [ "prompt", "listbox" ];
    background-color: @main-bg;
}

prompt {
    padding: 10px 180;
    width: 100%;
    background-color: transparent;
    text-color: #fcb1e4;
    font: "pixelon 16";
    horizontal-align: center;
    vertical-align: center;
    // force Rofi prompt text color & centering hack:
    border: 0px;
    spacing: 0px;
}

listbox {
    padding: 0px;
    spacing: 0px;
    orientation: horizontal;
    children: [ "listview" ];
    background-color: transparent;
}

listview {
    padding: 20px 100px 10px 100px;
    spacing: 1px;
    columns: 1;
    layout: vertical;
    cycle: true;
    dynamic: true;
    fixed-height: true;
    fixed-columns: false;
    justify: center;
    background-color: transparent;
    text-color: #24283B;
}

element {
    orientation: horizontal;
    spacing: 20px;
    padding: 8px 16px;
    border-radius: 20px;
    cursor: pointer;
    background-color: transparent;
    text-color: #24283B;
}

element selected.normal {
    background-color: @select-bg;
    text-color: #24283B;
    border-radius: 20px;
    margin: 0px 80px;
}

element-icon {
    size: 50px;
    cursor: inherit;
    background-color: transparent;
    text-color: #24283B;
}

element-text {
    vertical-align: 0.5;
    horizontal-align: 0;
    cursor: inherit;
    background-color: transparent;
    text-color: #fcb1e4;
}
